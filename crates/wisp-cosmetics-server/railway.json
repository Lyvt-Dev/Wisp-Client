{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "crates/wisp-cosmetics-server/Dockerfile",
    "watchPatterns": [
      "/crates/wisp-cosmetics/**",
      "/crates/wisp-cosmetics-server/**",
      "/crates/wisp-compat/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
